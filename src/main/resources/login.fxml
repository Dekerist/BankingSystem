<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="350" prefWidth="400" spacing="15" style="-fx-padding: 30; -fx-background-color: #0b1220;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="BANKING SYSTEM" />

    <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="Customer Login" />

    <TextField fx:id="usernameField" maxWidth="250" promptText="Enter username" />

    <PasswordField fx:id="passwordField" maxWidth="250" promptText="Enter password" />

   <Button fx:id="loginButton" onAction="#handleLogin" prefWidth="250" text="LOGIN" />
        
    <Label fx:id="messageLabel" style="-fx-text-fill: white;" text="" />

</VBox>
